# Supabase — find these in your Supabase project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — find in Stripe Dashboard > Developers > API Keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Google Text-to-Speech — Google Cloud Console > APIs > Text-to-Speech API
EXPO_PUBLIC_GOOGLE_TTS_API_KEY=your-google-tts-api-key

# ElevenLabs — https://elevenlabs.io/app/profile (for Tier 2 AI narrations)
EXPO_PUBLIC_ELEVENLABS_API_KEY=your-elevenlabs-api-key
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Supabase Edge Function Secrets ──────────────────────────────────────────
# Set these via: supabase secrets set KEY=value
# (NOT in this file — they are server-side only)
#
# SUPABASE_SERVICE_ROLE_KEY       (auto-injected by Supabase runtime)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ANTHROPIC_API_KEY=sk-ant-...    (for synthesize-poi via Claude)
# OPENAI_API_KEY=sk-...           (for synthesize-poi via GPT-4o)
# GOOGLE_TTS_API_KEY=...          (server-side TTS in synthesize-poi)
# DB_WEBHOOK_SECRET=...           (for create-profile DB webhook)
